{
  "name": "intentarc",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonman62/intentarc.git"
  },
  "packageManager": "pnpm@11.0.8",
  "type": "module",
  "productName": "IntentArc",
  "main": "dist/desktop/entry.js",
  "author": "IntentArc contributors",
  "description": "Local-first project coherence for AI-assisted work.",
  "bin": {
    "intentarc": "./dist/cli/bin.js",
    "intentarc-mcp": "./dist/mcp/bin.js",
    "intentarc-web": "./dist/web/bin.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build && node scripts/web-bundle-budget.mjs",
    "build": "pnpm build:server && pnpm build:web",
    "desktop:dev": "pnpm build && electron-forge start",
    "bridge:build": "pnpm build:server && node scripts/build-bridge.mjs",
    "desktop:resources": "node scripts/prepare-desktop-resources.mjs",
    "desktop:package": "pnpm build && pnpm bridge:build && pnpm desktop:resources && electron-forge package --platform win32 --arch x64",
    "desktop:make": "pnpm build && pnpm bridge:build && pnpm desktop:resources && node scripts/prepare-squirrel-vendor.mjs && electron-forge make --platform win32 --arch x64",
    "desktop:test:installer": "node scripts/squirrel-uninstall-acceptance.mjs",
    "desktop:test:packaged-reliability": "node scripts/windows-packaged-reliability.mjs",
    "desktop:test:client-portability:supervisor:build": "node scripts/build-client-portability-supervisor.mjs",
    "desktop:test:client-portability": "pnpm desktop:test:client-portability:supervisor:build && vitest run src/desktop/e2e/client-portability-live.test.ts --maxWorkers=1",
    "desktop:test:client-portability:cleanup": "pnpm build:server && node dist/desktop/e2e/client-portability-cleanup-cli.js",
    "desktop:test:signed-artifact": "vitest run src/desktop/e2e/signed-artifact-bundle.test.ts --maxWorkers=1",
    "desktop:release": "node scripts/desktop-release.mjs",
    "desktop:release:preflight": "node scripts/desktop-release-preflight.mjs",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:web",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "dev:server": "tsx watch src/web/bin.ts --db .intentarc-dev.sqlite --port 47861 --dev-origin http://127.0.0.1:5173",
    "dev:web": "vite",
    "web": "node dist/web/bin.js",
    "test:e2e": "pnpm build && tsx src/web/test-support/e2e-runner.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.1",
    "commander": "^15.0.0",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@electron/windows-sign": "1.2.2",
    "@playwright/test": "1.62.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "esbuild": "0.28.1",
    "extract-zip": "2.0.1",
    "jsdom": "30.0.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.23.1",
    "typescript": "^7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
