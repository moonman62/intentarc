{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*.ts", "src/**/*.cts", "src/**/*.js"],
  "exclude": [
    "dist",
    "**/*.test.ts",
    "src/desktop/e2e/fixtures/**",
    "src/web/client/**",
    "src/web/e2e/**"
  ]
}
